{
	"name": "magicandmilitary",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"typecheck:baseline": "bash scripts/typecheck-baseline.sh",
		"typecheck:baseline:save": "tsc --noEmit -p tsconfig.json 2>&1 | tsc-baseline save",
		"typecheck:baseline:clear": "tsc-baseline clear",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,jsx,ts,tsx,json,css}": [
			"biome check --write --no-errors-on-unmatched"
		],
		"*.{ts,tsx}": [
			"eslint --max-warnings 0"
		]
	},
	"dependencies": {
		"next": "16.4.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "^10.1.0",
		"server-only": "^0.0.1",
		"uploadthing": "^7.7.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@tailwindcss/turbopack": "4.3.3",
		"@types/node": "^20.19.43",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.4.6",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"tailwindcss": "4.3.3",
		"tsc-baseline": "^2.1.0",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@11.11.0"
}
